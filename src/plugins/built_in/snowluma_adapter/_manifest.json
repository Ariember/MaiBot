{
  "manifest_version": 2,
  "version": "1.3.1",
  "name": "OneBot 适配器",
  "description": "内置 QQ OneBot v11 适配器，支持 SnowLuma、NapCat 和通用标准模式",
  "author": {
    "name": "MaiBot Team",
    "url": "https://github.com/Mai-with-u/MaiBot-SnowLuma-Adapter"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Ariember/MaiBot",
    "homepage": "https://github.com/Ariember/MaiBot",
    "documentation": "https://github.com/Ariember/MaiBot/tree/main/src/plugins/built_in/snowluma_adapter",
    "issues": "https://github.com/Ariember/MaiBot/issues"
  },
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon-v2.png"
    }
  },
  "host_application": {
    "min_version": "1.3.21",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.98.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "silk-python",
      "version_spec": ">=0.2.8"
    }
  ],
  "capabilities": [
    "runtime.set_status_badges",
    "chat.get_all_streams",
    "chat.open_session",
    "component.disable",
    "component.enable",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "id": "maibot-team.snowluma-adapter"
}
